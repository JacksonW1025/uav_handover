# 保留项目源码、仿真资源、策略检查点、实验证据、依赖清单和文档。
# 大体积原始飞行数据（2026-10-15 起）只保存在实验机本地，不进远程仓库；见 data/README.md“数据保存策略”。

# 整个 Lab 属于本机实验环境，不上传；项目实验源码、数据和文档放在 Lab 外。
/uav_lab/

# 每轮 SITL 的运行副本和本机 IPC 命令链接；原始 flight.ulg、证据与结果保留。
/data/*/rootfs/
/data/*/cli/
# P9 keeps each counted attempt in its own directory with a nested run/.
/data/p9-*/**/rootfs/
/data/p9-*/**/cli/

# 原始飞行数据只保存在本机：ULog、逐物理步电机轨迹、逐帧遥测/资源记录、Gazebo 原始传感器抓取。
# 每轮 metadata.json 记录 flight.ulg 的 SHA-256，可与本机原始文件核对。保留三个完整示例 ULog。
/data/**/flight.ulg
/data/**/gz-motor/
/data/**/telemetry.jsonl
/data/**/resources.jsonl
/data/**/logs/gz-imu.log
/data/**/logs/gz-pressure.log
/data/**/logs/probe-*.log
!/data/p1-20261013-b02-S1-c_to_n-1/flight.ulg
!/data/p2-20261015-s1a-S1-c_to_n-N0-1/flight.ulg
!/data/p2-20261015-s1a-S1-c_to_n-N2-1/flight.ulg

# PX4 / CMake / ROS 2 中间产物
build/
build-*/
cmake-build-*/
install/
install-*/
# log/ 专用于 colcon 构建日志；实验日志使用 logs/ 或 data/。
log/
CMakeFiles/
CMakeCache.txt
compile_commands.json
Testing/
.ninja_deps
.ninja_log
*.o
*.obj
*.a
*.so
*.so.*

# Python 本地环境、缓存和打包中间产物
.venv/
venv/
venvs/
env/
.envs/
.conda/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
*.egg-info/
.eggs/
/dist/
.coverage
.coverage.*
htmlcov/

# 本地运行环境及下载缓存
.cache/
.ccache/
.ros/
.gz/
.gazebo/
node_modules/

# 本地环境变量和凭据；无敏感信息的模板允许提交。
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 编辑器、系统和临时文件
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tmp
*.temp
# P11 preserved old binary and full per-send sidecars remain local; hashes are delivered.
data/p11-*/px4-before-p11
data/p11-*/**/p11-sends.jsonl
/data/p12-*/**/rootfs/
/data/p12-*/**/cli/
/data/p12-*/**/p11-sends.jsonl
# Full structured repack of raw per-physics motor data, retained locally.
/data/p12-*/**/execution.npz
# Verbose check of verbatim generated evidence; scoped result/hash is delivered.
/data/p12-*/**/source-whitespace-check.log
# Actual P12 continuation runtime snapshots, local only; manifest is committed.
/data/p12-cont-*/**/runtime-local/
/data/p12-cont-*-runtime-local/
# Disconnection left long raw resource streams; preserve locally with manifest.
/data/p12-cont-20261026-development/window-10-single-repair/run/logs/gz-stats.log
/data/p12-cont-20261026-development/window-10-single-repair/run/logs/tegrastats.log
# Continuation full derived arrays are retained locally, uniformly hashed in delivery.
# No fields/samples omitted; policy arrays remain a small frozen model input.
/data/p12-cont-*/**/*.npz
!/data/p12-cont-20261026-freeze/models/policy.npz
# Formal disconnect resource logs retained locally and covered by raw manifest.
/data/p12-cont-20261026-formal/b1-ph2-NORMAL1/run/logs/gz-stats.log
/data/p12-cont-20261026-formal/b1-ph2-NORMAL1/run/logs/tegrastats.log
# P12b full source/build inputs and runtime copies, retained locally with manifests.
/data/p12b-*-source-local/
/data/p12b-*-runtime-local/
/data/p12b-*/**/*.npz
!/data/p12b-20261026-freeze/models/policy.npz
/data/p12b-*/**/rootfs/
/data/p12b-*/**/cli/
/data/p12b-*/**/p11-sends.jsonl
/data/p12b-*/**/*.bin
/data/p12c-*-runtime-local/
/data/p12c-*/**/*.npz
!/data/p12c-20261026-freeze/models/policy.npz
/data/p12c-*/**/*.bin
/data/p12c-*/**/rootfs/
/data/p12c-*/**/cli/
/data/p12c-*/**/p11-sends.jsonl
# P13 raw physics/flight and ordinary runtime snapshots stay local, hash manifests delivered.
/data/p13-*-runtime-local*/
/data/p13-*/**/*.bin
/data/p13-*/**/*.npz
!/data/p13-20261026-preparation/models/policy.npz
!/data/p13-20261026-freeze/models/policy.npz
/data/p13-*/**/rootfs/
/data/p13-*/**/cli/
/data/p13-*/**/p11-sends.jsonl
/data/p13-*/**/logs/gz-stats.log
