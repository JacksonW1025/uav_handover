# 整个 Lab 属于本机实验环境，不上传；项目实验源码、数据和文档放在 Lab 外。
/uav_lab/

# 每轮 SITL 的运行副本和本机 IPC 命令链接；原始 flight.ulg、证据与结果保留。
/data/*/rootfs/
/data/*/cli/

# PX4 / CMake / ROS 2 中间产物
build/
build-*/
cmake-build-*/
install/
install-*/
# log/ 专用于 colcon 构建日志；实验日志使用 logs/ 或 data/。
log/
CMakeFiles/
CMakeCache.txt
compile_commands.json
Testing/
.ninja_deps
.ninja_log
*.o
*.obj
*.a
*.so
*.so.*

# Python 本地环境、缓存和打包中间产物
.venv/
venv/
venvs/
env/
.envs/
.conda/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
*.egg-info/
.eggs/
/dist/
.coverage
.coverage.*
htmlcov/

# 本地运行环境及下载缓存
.cache/
.ccache/
.ros/
.gz/
.gazebo/
node_modules/

# 本地环境变量和凭据；无敏感信息的模板允许提交。
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 编辑器、系统和临时文件
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tmp
*.temp

# 基线仅保留data说明；本地输出、失败记录不删除、不默认上传。
/data/*
!/data/README.md
*.ulg
