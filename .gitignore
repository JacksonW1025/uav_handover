# P14 is offline only; complete derived arrays stay local, manifests are committed.
/data/p14-*/**/*.npz
# P14R passive raw/snapshots remain local, uniformly hashed in manifests.
/data/p14r-*/**/*.npz
/data/p14r-*/**/*.bin
/data/p14r-*/**/build/
/data/p14r-*/**/rootfs/
/data/p14r-*/**/cli/
/data/p14r-*/**/p11-sends.jsonl
# P14G: fully offline full arrays/checkpoints are local, uniformly hashed.
/data/p14g-*/**/*.npz
/data/p14g-*/**/*.bin

# P14H independent raw arrays/runtime snapshots remain local.
/data/p14h-*/**/*.npz
/data/p14h-*/**/*.bin
/data/p14h-*/**/rootfs/
/data/p14h-*/**/cli/
/data/p14h-*/**/p11-sends.jsonl
# Full per-call forecast/branch records are local raw derived data. Every
# terminal result, failure and source hash is indexed in the P14H delivery.
/data/p14h-*/offline-v*/[0-9][0-9][0-9]/result/result.json
/data/p14h-*/response-trials-v*/[0-9][0-9][0-9]/result/result.json
/data/p14h-*/selection-v*/[0-9][0-9][0-9]/result/result.json
/data/p14h-*/prediction-*/worker/result/*.json
/data/p14h-*/**/*.lock
/data/p14h-*/evaluation-*/**/result/result.json
/data/p14h-*/counterfactual-response-*/[0-9][0-9][0-9]/result/result.json
# P15 independent raw/runtime and full per-call model data remain local.
/data/p15-*/**/*.npz
/data/p15-*/**/*.bin
/data/p15-*/**/rootfs/
/data/p15-*/**/cli/
/data/p15-*/**/p11-sends.jsonl
/data/p15-*/**/*.lock
/data/p15-*/baseline.json
/data/p15-*/**/run/p15-selection-input.json
/data/p15-*/**/run/p15-selection.json
/data/p15-*/**/run/p15-map-prior-input.json
/data/p15-*/**/run/p15-map-prior.json
/data/p15-*/benchmark-v*/result.json
/data/p15-*/evaluation/*/forecast.json
/data/p15-*/**/logs/gz-stats.log
/data/p15-*/**/logs/tegrastats.log
