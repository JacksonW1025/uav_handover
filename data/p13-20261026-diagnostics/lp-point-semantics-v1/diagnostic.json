  "source_relations": [
    "EKF2::PublishLocalPosition explicitly publishes position/velocity of body origin via EKF getPosition/getVelocity",
    "OutputPredictor subtracts rotated IMU offset from IMU state for body origin and subtracts omega cross imu_offset from velocity",
    "x500_base pose0 0 .24; IMU/baro/navsat sensors underbase_link without separate sensorpose inSDF",
    "Named model origin and PX4 body-origin measurement reference cannot be assumed identical, even with equal initial altitude offset"
  ],
  "frozen_M5_limitation": "M5 maps COM to named-model origin with .241869 body offset and holds initial LP z/v residuals constant. Source body-point semantics require independent base/body/IMU-offset mapping; the .241869 named-model lever is not automatically the LP body lever. Frozen M5/heldout scores remain unchanged.",
  "not_exact_EKF_reproduction": "EKF internal origin, height reference, noise/filter and latency still unknown; nearest-past direct comparisons do not prove exact delay or all body-frame parameters",
  "no_new_candidate_or_refit": true,
  "formal_results_used_for_parameters": false,
  "new_SITL": 0
}
