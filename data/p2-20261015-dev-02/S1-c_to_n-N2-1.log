created {'thresholds': {'seed': 42, 'instance': 21, 'ros_domain_id': 71, 'agent_port': 18888, 'startup_timeout_s': 90, 'takeoff_timeout_s': 45, 'landing_timeout_s': 60, 'hover_s': 10, 'neural_s': 5, 'repetitions': 3, 'altitude_m': 3, 'hover_max_error_m': 1.0, 'hover_max_tilt_deg': 15, 'safety_radius_m': 10, 'safety_altitude_m': 8, 'safety_tilt_deg': 45, 'safety_angular_rate_rad_s': 8, 'inference_p99_us': 2500, 'settling_band_m': 0.2, 'settling_dwell_s': 2.0, 'joint_recovery': {'position_reference': 'active_controller_target', 'position_reference_note': "Same rule as P0 (the controller's own position target), extended to RAPTOR: its internal target is not published on trajectory_setpoint, so while RAPTOR owns the actuators the target is its logged capture (activation reset or setpoint-stale hold); classic stages use trajectory_setpoint as in P0. trajectory_setpoint-only and fixed NED results are kept as comparisons.", 'position_reference_ned_m': [0, 0, -3], 'velocity_reference_ned_m_s': [0, 0, 0], 'angular_velocity_reference_frd_rad_s': [0, 0, 0], 'position_threshold_m': 0.2, 'velocity_threshold_m_s': 0.1, 'angular_velocity_threshold_rad_s': 0.1, 'dwell_s': 2.0, 'max_observation_gap_s': 0.02}, 'p0_strict': True, 'p2': {'purpose': 'P2 internal-state treatments at RAPTOR takeover (C->N) and velocity-integrator coordination at classic takeover (N->C). RAPTOR activation target capture (current position/yaw, zero velocity) is unchanged; only the GRU hidden state and previous action are written.', 'conditions': {'S1': {'speed_m_s': 0.0, 'description': 'stable hover (P1 S1)'}, 'S3': {'speed_m_s': 1.0, 'raptor_baseline_speed_m_s': 1.0, 'description': '1.0 m/s along +N (P1 S3). raptor_baseline_speed_m_s is calibrated by development runs so that the RAPTOR baseline capture speed lies in 1.00-1.04 m/s like the C->N handovers.'}, 'X1.5': {'speed_m_s': 1.5, 'start_offset_m': -6.0, 'cruise_s': 1.5, 'description': 'exploration'}, 'X2.0': {'speed_m_s': 2.0, 'start_offset_m': -6.0, '