created {'thresholds': {'seed': 42, 'instance': 21, 'ros_domain_id': 71, 'agent_port': 18888, 'startup_timeout_s': 90, 'takeoff_timeout_s': 45, 'landing_timeout_s': 60, 'hover_s': 10, 'neural_s': 5, 'repetitions': 3, 'altitude_m': 3, 'hover_max_error_m': 1.0, 'hover_max_tilt_deg': 15, 'safety_radius_m': 10, 'safety_altitude_m': 8, 'safety_tilt_deg': 45, 'safety_angular_rate_rad_s': 8, 'inference_p99_us': 2500, 'settling_band_m': 0.2, 'settling_dwell_s': 2.0, 'joint_recovery': {'position_reference': 'active_controller_target', 'position_reference_note': "Same rule as P0 (the controller's own position target), extended to RAPTOR: its internal target is not published on trajectory_setpoint, so while RAPTOR owns the actuators the target is its logged capture (activation reset or setpoint-stale hold); classic stages use trajectory_setpoint as in P0. trajectory_setpoint-only and fixed NED results are kept as comparisons.", 'position_reference_ned_m': [0, 0, -3], 'velocity_reference_ned_m_s': [0, 0, 0], 'angular_velocity_reference_frd_rad_s': [0, 0, 0], 'position_threshold_m': 0.2, 'velocity_threshold_m_s': 0.1, 'angular_velocity_threshold_rad_s': 0.1, 'dwell_s': 2.0, 'max_observation_gap_s': 0.02}, 'p0_strict': True, 'p2': {'purpose': 'P2 internal-state treatments at RAPTOR takeover (C->N) and velocity-integrator coordination at classic takeover (N->C). RAPTOR activation target capture (current position/yaw, zero velocity) is unchanged; only the GRU hidden state and previous action are written.', 'conditions': {'S3': {'speed_m_s': 1.0, 'raptor_baseline_speed_m_s': 1.05, 'description': 'development calibration of the RAPTOR S3 baseline command speed'}, 'S3h': {'speed_m_s': 1.0, 'raptor_baseline_speed_m_s': 1.07, 'description': 'development calibration of the RAPTOR S3 baseline command speed'}}, 'profile_overrides': ['start_offset_m', 'cruise_s', 'accel_s', 'reference_hold_s'], 'exploration_rationale': 'Exploration conditions first move 6 m back along -N at 0.5 m/s (trapezoid, 0.5 m/s^2) and hold 3 s, then ramp for 2 s and cruise 1.5 s, so that 3.0 m/s reaches the trigger near +1.5 m and leaves more than 8 m to the frozen 10 m safety radius for braking.', 'treatments': {'N0': {'rini': 0, 'description': 'original RAPTOR mode-entry reset'}, 'N1': {'rini': 2, 'description': 'GRU reset; previous action = classic last applied actuator_motors in RAPTOR action space'}, 'N2g': {'rini': 3, 'description': 'while inactive the shadow inference sees classic applied motors as previous action (teacher forcing); entry keeps the GRU, previous action reset'}, 'N2': {'rini': 4, 'description': 'teacher forcing as N2g; entry keeps the GRU and sets previous action = classic last applied motors'}, 'N2s': {'rini': 1, 'description': 'pre-existing RINI=1: keep the shadow inference memory (own shadow actions)'}, 'Nstar': {'rini': 5, 'description': 'S1 only: staged GRU and previous action of a RAPTOR S1 baseline at the same phase (upper bound)'}, 'C0': {'nco': 0, 'description': 'original classic AUTO_LOITER takeover'}, 'C2': {'nco': 1, 'description': 'classic velocity integrator coordinated with RAPTOR last applied collective thrust along the current body z axis'}, 'B': {'rini': 0, 'nco': 0, 'description': 'same-controller baseline, no treatment'}}, 'nstar_memory': {'values': [-0.3560881018638611, 0.048067495226860046, 0.26853084564208984, 0.4074706435203552, 0.3177782893180847, 0.46001094579696655, 0.2689172327518463, -0.26783421635627747, -0.7964303493499756, 0.8689482808113098, 0.35409682989120483, 0.270914226770401, 0.24861067533493042, -0.3970729410648346, -0.551681399345398, -0.2627330720424652, 0.4586929678916931, 0.4579644203186035, 0.45826324820518494, 0.45831915736198425], 'source': 'data/p2-20261015-dev02-S1-baseline_raptor-B-1', 'extraction': 'data/p2-20261015-nstar/nstar-memory.json (tools/p2_nstar.py)', 'phase': 'RAPTOR S1 baseline at trigger + 36 ms (median C->N trigger-to-owner-change of the development runs)', 'layout': 'GRU hidden state [0:16] 