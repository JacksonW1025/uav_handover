 namespace
 {
+#if defined(__PX4_POSIX)
+// Read-only SITL timing observer. The recorded values never feed inference or control.
+void mcnn_trace(char event, uint64_t when, const trajectory_setpoint_s &sp,
+                const vehicle_local_position_s &pos, const float *act = nullptr)
+{
+ static FILE *file = []() -> FILE * {
+  const char *name = std::getenv("MCNN_NATIVE_TRACE");
+  return name ? std::fopen(name, "w") : nullptr;
+ }();
+ if (!file) { return; }
+ std::fprintf(file, "%c,%llu,%llu,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g\n",
+  event, static_cast<unsigned long long>(when), static_cast<unsigned long long>(sp.timestamp),
+  static_cast<double>(sp.position[0]), static_cast<double>(sp.position[1]), static_cast<double>(sp.position[2]),
+  static_cast<double>(pos.x), static_cast<double>(pos.y), static_cast<double>(pos.z),
+  static_cast<double>(act ? act[0] : NAN), static_cast<double>(act ? act[1] : NAN),
+  static_cast<double>(act ? act[2] : NAN), static_cast<double>(act ? act[3] : NAN));
+ if (event == 'A') { std::fflush(file); }
+}
+#endif
 }  // namespace
 
